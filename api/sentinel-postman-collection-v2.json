{
  "info": {
    "_postman_id": "8157f3c5-7ece-4338-8954-dd8468c3ec93",
    "name": "Sentinel API",
    "description": "Postman collection for Sentinel telemetry ingestion, alerts, and monitoring.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "Ingest telemetry event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"evt-1001\",\n  \"source\": \"payment-service\",\n  \"entityId\": \"merchant-42\",\n  \"metric\": \"latency_ms\",\n  \"value\": 125.4,\n  \"timestamp\": \"2026-09-07T10:00:00Z\",\n  \"attributes\": {\n    \"region\": \"ap-south-1\",\n    \"service\": \"checkout\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Submit a telemetry event. Expected response: 202 Accepted."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "List recent alerts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/alerts?limit=20"
          },
          "response": []
        },
        {
          "name": "List alerts by severity",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/alerts/severity/CRITICAL?limit=20",
            "description": "Severity can be LOW, MEDIUM, HIGH, or CRITICAL."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Monitoring",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          },
          "response": []
        },
        {
          "name": "Prometheus metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/prometheus"
          },
          "response": []
        }
      ]
    }
  ]
}